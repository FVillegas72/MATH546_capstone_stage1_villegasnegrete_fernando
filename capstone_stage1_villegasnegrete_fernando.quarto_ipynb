      "source": [
        "improvement_plot = final_ml_scores.copy().sort_values(\"RMSE improvement (%)\", ascending=True)\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "ax.barh(improvement_plot.index, improvement_plot[\"RMSE improvement (%)\"])\n",
        "ax.axvline(0, color=\"black\", linewidth=1)\n",
        "ax.set_title(\"RMSE Improvement Relative to Naive Benchmark\")\n",
        "ax.set_xlabel(\"Improvement (%)\")\n",
        "ax.set_ylabel(\"Model\")\n",
        "\n",
        "for i, value in enumerate(improvement_plot[\"RMSE improvement (%)\"]):\n",
        "    ax.text(value + 0.2, i, f\"{value:.2f}%\", va=\"center\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "7bea4c46",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "We measure the Diebold-Mariano statistic to see if the differences are significant."
      ],
      "id": "9a8d368f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "import statsmodels.api as sm\n",
        "from scipy import stats\n",
        "\n",
        "def dm_hac(\n",
        "    forecasts,\n",
        "    model_a,\n",
        "    model_b,\n",
        "    loss=\"squared\",\n",
        "    hac_lags=3,\n",
        "    scale=10000\n",
        "):\n",
        "    \"\"\"\n",
        "    Diebold-Mariano style test using HAC standard errors.\n",
        "    \n",
        "    H0: E[d_t] = 0, where d_t = L_a,t - L_b,t\n",
        "    Negative mean difference favors model_a.\n",
        "    \"\"\"\n",
        "\n",
        "    data = forecasts[[\"actual\", model_a, model_b]].dropna().copy()\n",
        "\n",
        "    y = scale * data[\"actual\"].to_numpy()\n",
        "    fa = scale * data[model_a].to_numpy()\n",
        "    fb = scale * data[model_b].to_numpy()\n",
        "\n",
        "    ea = y - fa\n",
        "    eb = y - fb\n",
        "\n",
        "    if loss == \"squared\":\n",
        "        d = ea**2 - eb**2\n",
        "    elif loss == \"absolute\":\n",
        "        d = np.abs(ea) - np.abs(eb)\n",
        "    else:\n",
        "        raise ValueError(\"loss must be 'squared' or 'absolute'\")\n",
        "\n",
        "    X = np.ones((len(d), 1))\n",
        "\n",
        "    res = sm.OLS(d, X).fit(\n",
        "        cov_type=\"HAC\",\n",
        "        cov_kwds={\"maxlags\": hac_lags, \"use_correction\": True},\n",
        "        use_t=True\n",
        "    )\n",
        "\n",
        "    t_stat = float(res.tvalues[0])\n",
        "    p_two_sided = float(res.pvalues[0])\n",
        "\n",
        "    # one-sided p-value for H1: model_a better than model_b\n",
        "    # i.e. E[d_t] < 0\n",
        "    df = int(res.df_resid)\n",
        "    p_one_sided_less = stats.t.cdf(t_stat, df=df)\n",
        "\n",
        "    return pd.Series({\n",
        "        \"N\": len(d),\n",
        "        \"Mean loss difference\": float(res.params[0]),\n",
        "        \"Standard error\": float(res.bse[0]),\n",
        "        \"DM-HAC statistic\": t_stat,\n",
        "        \"p-value (two-sided)\": p_two_sided,\n",
        "        \"p-value (one-sided, model_a better)\": p_one_sided_less\n",
        "    })\n",
        "\n",
        "dm_comparisons = [\n",
        "    (\"XGBoost - Market + On-chain\", \"Naive\"),\n",
        "    (\"XGBoost - Market + On-chain\", \"GARCH(1,1)\"),\n",
        "    (\"RF - Market + On-chain\", \"Naive\"),\n",
        "    (\"RF - Market + On-chain\", \"GARCH(1,1)\"),\n",
        "    (\"XGBoost - Market + On-chain\", \"RF - Market + On-chain\"),\n",
        "    (\"XGBoost - Market + On-chain\", \"XGBoost - Market\"),\n",
        "    (\"RF - Market + On-chain\", \"RF - Market\"),\n",
        "]\n",
        "\n",
        "dm_rows = []\n",
        "\n",
        "for model_a, model_b in dm_comparisons:\n",
        "    out = dm_hac(\n",
        "        final_ml_test,\n",
        "        model_a=model_a,\n",
        "        model_b=model_b,\n",
        "        loss=\"squared\",\n",
        "        hac_lags=3\n",
        "    )\n",
        "    row = {\"Model A\": model_a, \"Model B\": model_b}\n",
        "    row.update(out.to_dict())\n",
        "    dm_rows.append(row)\n",
        "\n",
        "dm_results = pd.DataFrame(dm_rows)\n",
        "\n",
        "display(dm_results.round(4))"
      ],
      "id": "e1e0b7ab",
      "execution_count": null,
      "outputs": []
    }
